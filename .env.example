VITE_GOOGLE_MAPS_API_KEY=YOUR_API_KEY_HERE

# Supabase (server-side) - do NOT expose the service role key to the client
# For local population scripts use SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY (keep them secret)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

